[sub_resource type="GDScript" id="GDScript_2lphw"]
script/source = "extends Node3D


# Called when the node enters the scene tree for the first time.
func _ready():
	var T = Thread.new()
	T.start(checkPoints())
	pass 
	
	
func checkPoints():
	var points = get_children()
	
	
	for point in points:
		var space_state = get_world_3d().direct_space_state
		var result = space_state.intersect_point(point)
		if (Array.lenth(result)):
			get_parent().find_child(\"MeshInstance3D\").material_override = null
		
		
	pass


"

